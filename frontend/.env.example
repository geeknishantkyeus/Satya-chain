# ============================================
# Satya-Chain Frontend Environment Configuration
# ============================================

# Backend API URL for server-side IPFS pinning and verification
REACT_APP_API_URL=http://localhost:5000/api

# Pinata Gateway for fast PDF rendering
REACT_APP_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Optional client-side fallback if backend is not used
REACT_APP_PINATA_JWT=
