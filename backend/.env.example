# ============================================
# Satya-Chain Backend Environment Configuration
# ============================================

# Server Port (Default: 5000)
PORT=5000

# Private key for deployment (Polygon Amoy Testnet).
# Must be a 64-character hex string prefixed with 0x.
# For local Hardhat node, this is NOT needed (deterministic test accounts are provided).
PRIVATE_KEY=

# RPC URL for Polygon Amoy Testnet (Optional, defaults to official public RPC if empty)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology/

# Pinata IPFS Secret JWT for server-side PDF & NFT metadata pinning
# Generate at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
